# Copy to .env and fill in. Never commit .env.

# development | production
NODE_ENV=production
PORT=3000
# Public address of the site — used for canonical URLs, Open Graph, sitemap and JSON-LD.
SITE_URL=https://themusicofheart.com
# Set to 1 when running behind one proxy/load balancer (Render, Railway, Nginx) so rate limits see real visitor IPs.
TRUST_PROXY=1

# MongoDB (e.g. MongoDB Atlas). Required in production.
# In development, leave empty to use the built-in local database (server/.data).
MONGODB_URI=

# Session signing secret, at least 32 random characters. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The single admin account is created from the command line, not over the web:
#   npm run create-admin -- owner@example.com "a long password"
# In development only, these create it automatically on first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Media storage for uploaded photos: local (server/uploads) or s3 (any S3-compatible bucket, e.g. Cloudflare R2).
# Use s3 on hosts whose disk is wiped on redeploy.
STORAGE_DRIVER=local
# Public base URL for media: /uploads for local, or the bucket's public URL for s3 (e.g. https://media.themusicofheart.com).
MEDIA_BASE_URL=/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
